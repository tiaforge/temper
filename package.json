{
  "name": "@tiaforge-ui/tinystyle",
  "version": "0.1.0",
  "description": "Tiny, AI-first CSS for semantic HTML: data-* variants with a checked vocabulary, automatic light and dark mode.",
  "license": "MIT",
  "author": "Tia Heinrich",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/core.css",
    "./core.css": "./dist/core.css",
    "./app.css": "./dist/app.css",
    "./menu.css": "./dist/menu.css",
    "./feedback.css": "./dist/feedback.css",
    "./table.css": "./dist/table.css",
    "./all.css": "./dist/all.css",
    "./vocab.json": "./vocab.json",
    "./html-custom-data.json": "./html-custom-data.json",
    "./types": {
      "types": "./types/attributes.d.ts"
    },
    "./svelte": {
      "types": "./types/svelte.d.ts"
    },
    "./react": {
      "types": "./types/react.d.ts"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    },
    "./astro": {
      "types": "./types/astro.d.ts"
    },
    "./sinter": {
      "types": "./types/sinter.d.ts"
    },
    "./check": "./lib/check.js",
    "./vite": "./lib/vite.js",
    "./icons.css": "./dist/icons.css",
    "./pico-compat.css": "./dist/pico-compat.css",
    "./enhance/*": "./dist/enhance/*"
  },
  "bin": {
    "tinystyle": "bin/tinystyle.js"
  },
  "files": [
    "dist",
    "LICENSE-lucide",
    "lib",
    "types",
    "bin",
    "vocab.json",
    "llms.txt",
    "html-custom-data.json",
    "llms-full.txt",
    "LICENSE"
  ],
  "keywords": [
    "css",
    "classless",
    "dark-mode",
    "light-dark",
    "oklch",
    "design-system",
    "llm",
    "ai"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "gen": "node scripts/gen.mjs",
    "check": "node bin/tinystyle.js check kitchen-sink",
    "test": "node scripts/gen.mjs --check && node --test test/*.test.js",
    "shots": "scripts/shoot.sh",
    "contrast": "node scripts/contrast.mjs",
    "visual": "node scripts/visual.mjs",
    "visual:prune": "node scripts/prune-visual.mjs",
    "readme-shots": "node scripts/readme-shots.mjs",
    "prepublishOnly": "npm run gen && npm test && npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "lightningcss": "^1.33.0",
    "lucide-static": "^1.70.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "lucide-static": ">=0.400.0"
  },
  "peerDependenciesMeta": {
    "lucide-static": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "types/attributes.d.ts"
      ],
      "svelte": [
        "types/svelte.d.ts"
      ],
      "react": [
        "types/react.d.ts"
      ],
      "vue": [
        "types/vue.d.ts"
      ],
      "astro": [
        "types/astro.d.ts"
      ],
      "sinter": [
        "types/sinter.d.ts"
      ]
    }
  }
}
